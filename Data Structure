from collections import deque

car_tuple = ("Toyota", "Fortuner", 2025, "Automatic", "White")
print("Tuple:", car_tuple)

car_set = {"Toyota", "Honda", "BMW", "Toyota"} 
print("Set:", car_set)

class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None

    def append(self, data):
        new_node = Node(data)
        if not self.head:
            self.head = new_node
        else:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = new_node

    def display(self):
        temp = self.head
        while temp:
            print(temp.data, end=" -> ")
            temp = temp.next
        print("None")

linked_list = LinkedList()
linked_list.append("Car")
linked_list.append("Motorcycle")
linked_list.append("Truck")
print("Linked List:")
linked_list.display()

stack = []
stack.append("Book 1")
